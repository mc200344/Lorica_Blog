---
import { Code } from "astro-expressive-code/components";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FeatureCard from "@/components/mdx/FeatureCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="首页">
  <MainCard
    title="Welcome to Lorica_Blog"
    description="以Astro为框架Frosti为主题的个人博客."
    textOverlay="你好"
    infoIcon="lucide:info"
  >
    <div class="space-y-8">
      <!-- Hero Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h2
            class="text-4xl font-bold mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent leading-loose"
          >
            🌟 测试
          </h2>
          <p class="text-xl text-base-content/80 max-w-3xl mb-8">
            测试看看这个
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect">
              <Icon name="lucide:book-open" class="w-5 h-5" />
              <span>探索博客</span>
            </a>
            <a href="https://github.com/mc200344/Lorica_Blog" target="_blank" rel="noopener noreferrer" class="btn btn-outline gap-2">
              <Icon name="lucide:github" class="w-5 h-5" />
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Features Section方块卡片 -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:sparkles" class="w-6 h-6 text-primary" />
          <span>Features</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <FeatureCard
            title="Responsive Design"
            description="Fully responsive design that looks great on all devices from mobile to desktop."
            icon="lucide:smartphone"
            color="oklch(0.7 0.2 30)"
          />

          <FeatureCard
            title="Dark/Light Mode"
            description="Toggle between light and dark themes with a beautiful transition effect."
            icon="lucide:moon"
            color="oklch(0.65 0.2 280)"
          />

          <FeatureCard
            title="MDX Support"
            description="Write your content in MDX with full support for custom components and JSX."
            icon="lucide:file-code"
            color="oklch(0.6 0.2 160)"
          />

          <FeatureCard
            title="SEO Optimized"
            description="Built-in SEO optimization with meta tags, OpenGraph, and JSON-LD."
            icon="lucide:search"
            color="oklch(0.6 0.2 200)"
          />

          <FeatureCard
            title="Fast Performance"
            description="Optimized for speed with lazy loading, code splitting, and minimal JavaScript."
            icon="lucide:zap"
            color="oklch(0.8 0.2 80)"
          />

          <FeatureCard
            title="Customizable"
            description="Easily customize the theme to match your personal brand and preferences."
            icon="lucide:palette"
            color="oklch(0.7 0.2 10)"
          />
          
        </div>
        <div class="card bg-base-200 p-6 mt-8">
          <h3 class="text-xl font-bold mb-4">更多功能</h3>
          <p class="text-base-content/70 mb-2">更多功能正在开发中，敬请期待！</p>
        </div>
                     
      </section>

      <!-- Quick Start -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:rocket" class="w-6 h-6 text-primary" />
          <span>大标题</span>
        </h2>

        <div class="card bg-base-200 p-6">
          <h3 class="text-xl font-bold mb-4">你好</h3>

          <ol class="space-y-6 mb-6">
            <li class="relative flex flex-col gap-4 items-start">
              <div class="flex gap-4 items-center">
                <div
                  class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-content flex-shrink-0"
                >
                  1
                </div>
                <h4 class="font-bold">测试1</h4>
              </div>
              <div class="relative w-full">
                <p class="text-base-content/70 mb-2">测试1.1</p>
                <Code code="git clone --depth 1 https://github.com/EveSunMaple/Frosti.git Frosti" lang="sh" />
                <p class="text-base-content/70 mb-2">测试1.1</p>
              </div>
            </li>

            <li class="relative flex flex-col gap-4 items-start">
              <div class="flex gap-4 items-center">
                <div
                  class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-content flex-shrink-0"
                >
                  2
                </div>
                <h4 class="font-bold">测试2</h4>
              </div>
              <div class="relative w-full">
                <p class="text-base-content/70 mb-2">测试2.1</p>
                <Code code="cd Frosti && pnpm install" lang="sh" />
              </div>
            </li>

            <li class="relative flex flex-col gap-4 items-start">
              <div class="flex gap-4 items-center">
                <div
                  class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-content flex-shrink-0"
                >
                  3
                </div>
                <h4 class="font-bold">测试3</h4>
              </div>
              <div class="relative w-full">
                <p class="text-base-content/70 mb-2">测试3.1</p>
                <Code code="pnpm run search:index && pnpm run dev" lang="sh" />
              </div>
            </li>
          </ol>
        </div>
      </section>

      <!-- GitHub Stats -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>GitHub统计</span>
        </h2>

        <GitHubStats username="mc200344" repositoryName="Lorica_Blog" />
      </section>
    </div>
  </MainCard>
</BaseLayout>
